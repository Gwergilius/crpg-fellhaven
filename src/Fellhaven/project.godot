config_version=5

[application]

config/name="Fellhaven"
config/description="A turn-based fantasy CRPG"
config/version="0.1.0-alpha"
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.4", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

LocalizationManager="*res://scripts/systems/LocalizationManager.cs"
GameState="*res://scripts/core/GameState.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Fellhaven"

